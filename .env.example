# Copy to .env and adjust. .env is gitignored and must never be committed (S3).
# Every variable below maps to a field on Settings in api/app/core/config.py.
#
# Adapter selection is by configuration alone (M4/E2): leave a provider key unset and
# the app uses its local equivalent. Out of the box that means SQLite + local disk +
# console email, so the whole stack runs with no Docker and no accounts ($1).

# --- Application ---------------------------------------------------------------
# Human-readable name, shown as the OpenAPI title.
APP_NAME="Alma Lead Intake API"
# Free-form deployment label: local | ci | staging | production.
# Outside "local", startup warns if the placeholder credentials below are still set.
ENVIRONMENT=local
# FastAPI debug mode. Never enable outside local development.
DEBUG=false
# Path prefix every v1 route is mounted under.
API_V1_PREFIX=/api/v1

# --- Web / CORS (S5) -----------------------------------------------------------
# JSON array of browser origins allowed to call the API. No wildcards.
CORS_ORIGINS=["http://localhost:3000"]
# Deep link to the internal queue, included in the attorney notification email.
INTERNAL_UI_URL=http://localhost:3000/leads
# Public status portal, linked from the prospect confirmation email (EXT1).
STATUS_PORTAL_URL=http://localhost:3000/status

# --- Persistence ($1) ----------------------------------------------------------
# SQLAlchemy URL. Default is a repo-local SQLite file, so the API runs with no Docker.
# Postgres profile instead: postgresql+psycopg://alma:alma@localhost:5432/alma
DATABASE_URL=sqlite:///./data/alma.db

# --- Auth (S1/S4) --------------------------------------------------------------
# HMAC signing key for JWTs. MUST be replaced with a long random value before deploy.
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
# Token lifetime in minutes (480 = 8h). There are no refresh tokens in this build.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# The single seeded attorney login. The password is bcrypt-hashed at startup and the
# plaintext is never persisted. MUST be replaced before deploy.
ATTORNEY_EMAIL=attorney@example.com
ATTORNEY_PASSWORD=changeme

# Multi-attorney roster (FR10). Assignment needs more than one attorney to be worth
# demonstrating, so three ship by default. The first entry is ATTORNEY_EMAIL above, so
# every example in the README keeps working. Delete this line entirely and the single
# ATTORNEY_EMAIL/ATTORNEY_PASSWORD account becomes the only login (the fallback path).
# Passwords are bcrypt-hashed at startup and never stored or logged in plaintext.
ATTORNEYS=[{"email":"attorney@example.com","password":"changeme","name":"Alex Chen"},{"email":"sam@example.com","password":"changeme","name":"Sam Reyes"},{"email":"nina@example.com","password":"changeme","name":"Nina Patel"}]

# --- Uploads (S2) --------------------------------------------------------------
# Directory for resumes when local-disk storage is active. Relative paths resolve
# against the repo root. Gitignored.
UPLOAD_DIR=uploads
# Hard size cap for a resume, in megabytes.
MAX_RESUME_MB=5
# Allow-lists applied to the declared content type, the file extension AND the
# actual leading bytes -- all three must agree (SEC2). Legacy .doc was dropped in P1
# because OLE documents are the classic macro-malware carrier.
ALLOWED_RESUME_CONTENT_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
ALLOWED_RESUME_EXTENSIONS=[".pdf",".docx"]

# --- Rate limiting (SEC1) --------------------------------------------------------
# Per-IP budgets on the public endpoints. Set false only for load testing.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LEADS=5/10minutes
RATE_LIMIT_LOGIN=10/5minutes
# Public status lookups by tracking code.
RATE_LIMIT_STATUS=20/minute
# In-memory is per-process. Point at redis://host:6379 to share limits across replicas.
RATE_LIMIT_STORAGE_URL=memory://

# --- Observability (M5) ------------------------------------------------------------
# true emits one JSON object per log line, for a log collector.
LOG_JSON=false
# Correlation header, honoured inbound and echoed on every response.
REQUEST_ID_HEADER=X-Request-ID

# --- Email -----------------------------------------------------------------------
# Leave RESEND_API_KEY unset for ConsoleEmailService (messages are logged, not sent).
# Setting it selects ResendEmailService in P1.
# RESEND_API_KEY=
# Envelope sender used by the real provider.
EMAIL_FROM=noreply@example.com
# Inbox that receives the new-lead notification.
ATTORNEY_NOTIFY_EMAIL=attorney@example.com

# --- Object storage --------------------------------------------------------------
# Leave S3_ENDPOINT_URL and S3_ACCESS_KEY_ID unset for LocalDiskStorage. Setting
# either selects S3Storage. For the MinIO profile:
#   docker compose --profile s3 up -d
# S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=alma-resumes
S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# --- Web app (read by Next.js, not by the API) ---------------------------------
# Base URL the browser and server components use to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
