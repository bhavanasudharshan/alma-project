<!doctype html>
<html lang="en">
  <body style="font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #171717; line-height: 1.5;">
    <p>Hi {{ first_name }},</p>
    <p>{{ headline }}</p>
    <p>{{ detail }}</p>
    {% if status_portal_url %}
    <p>
      You can check your status any time with your tracking code
      <strong style="font-family: ui-monospace, monospace;">{{ tracking_code }}</strong>:
      <a href="{{ status_portal_url }}">{{ status_portal_url }}</a>
    </p>
    {% endif %}
    <p>— Alma</p>
  </body>
</html>
